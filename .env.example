# ==============================================================================
# Godavari Grown (GG-UI) Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite)
# Add these in your Vercel / Netlify Dashboard under "Environment Variables":
# ------------------------------------------------------------------------------

# Ground Market Survey Demo Data Toggle:
# - Leave UNSET or set to 'false' in Production (starts with 0 surveys, completely blank).
# - Set to 'true' in Development to preview sample Godavari market data and charts.
VITE_ENABLE_DEMO_DATA=false

# Backend API URL:
# - Leave UNSET if deploying on Vercel (vercel.json automatically routes /api/* on the same domain).
# - Set ONLY if your Python backend is hosted on an external server (e.g. https://api.godavarigrown.com).
# VITE_API_URL=https://api.godavarigrown.com

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (FastAPI)
# ------------------------------------------------------------------------------
APP_ENV=production
ENABLE_DEMO_DATA=false

# Allowed Origins for CORS:
# CORS_ORIGINS=https://godavarigrown.com,https://your-project.vercel.app

# Optional: AI Chatbot / WhatsApp Integration
# GEMINI_API_KEY=your_gemini_api_key_here
# WHATSAPP_ACCESS_TOKEN=your_token
# WHATSAPP_PHONE_NUMBER_ID=your_phone_id

