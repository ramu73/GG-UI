# Godavari Grown API Configuration
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://godavarigrown.com

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_token_here
WHATSAPP_VERIFY_TOKEN=godavari_grown_verify_secret_2026
